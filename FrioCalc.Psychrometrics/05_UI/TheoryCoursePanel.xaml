<UserControl x:Class="FrioCalc.Psychrometrics.UI.TheoryCoursePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [5.6X] Curso completo, carta ASHRAE + A03 diapositivas 1 a 36. -->
    <Border BorderBrush="#9BB3C9" BorderThickness="1" Background="#F4F9FF"
            CornerRadius="9" Padding="14" Margin="0,0,0,18">
        <StackPanel>
            <TextBlock FontWeight="Bold" FontSize="18"
                       Text="CURSO DE PSICROMETRÍA · CARTA Y 36 DIAPOSITIVAS"
                       Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="Seleccione cualquier fundamento o diapositiva. El módulo explica conceptos, ecuaciones, lectura de líneas, limitaciones y aplicación al estado que manipula en el laboratorio."
                       TextWrapping="Wrap" Foreground="#374F64" Margin="0,0,0,12"/>
            <TextBlock Text="Tema de estudio" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="TopicSelector" Height="32" DisplayMemberPath="DisplayTitle"
                      SelectionChanged="TopicSelector_Changed" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="PreviousTopicButton" Content="Tema anterior" Click="PreviousTopic_Click"
                        Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="NextTopicButton" Content="Tema siguiente" Click="NextTopic_Click" Padding="10,6"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Ir a diapositiva A03:" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox x:Name="SlideSelector" Width="92" Height="30" SelectionChanged="SlideSelector_Changed"/>
                <TextBlock Text="1–36" VerticalAlignment="Center" Foreground="#56697C" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TopicHeading" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="TopicSlideLabel" FontWeight="SemiBold" Foreground="#476686"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="TopicSummary" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="FUNDAMENTO FÍSICO" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="TopicPhysics" TextWrapping="Wrap" Margin="0,0,0,11"/>
            <TextBlock Text="CÓMO LEERLO EN LA CARTA" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="TopicChartExplanation" TextWrapping="Wrap" Margin="0,0,0,9"/>
            <Border Background="White" BorderBrush="#CFDCE9" BorderThickness="1" CornerRadius="5"
                    Margin="0,0,0,12">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Canvas x:Name="ReadingCanvas" Width="700" Height="265"
                            IsHitTestVisible="False"/>
                </Viewbox>
            </Border>
            <TextBlock Text="RELACIÓN O ECUACIÓN" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="TopicEquation" FontFamily="Consolas" TextWrapping="Wrap"
                       FontSize="12.5" Margin="0,0,0,12"/>
            <TextBlock Text="PROCEDIMIENTO Y EJEMPLO DE USO" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="TopicProcedure" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Border Background="#FFF5E7" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <TextBlock x:Name="TopicLimits" TextWrapping="Wrap" FontSize="12.5"/>
            </Border>
            <Border Background="#E7F2FF" CornerRadius="5" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="LO QUE INDICA EL ESTADO ACTUAL DEL LABORATORIO"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="LiveStateExplanation" TextWrapping="Wrap" FontSize="12.5"/>
                </StackPanel>
            </Border>
            <TextBlock Text="FUENTE Y PROCEDENCIA" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="TopicReference" TextWrapping="Wrap" Foreground="#50697D"
                       FontSize="11.5" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,2">
                <Button x:Name="ExploreTopicButton" Content="Explorar este proceso en el laboratorio"
                        Click="ExploreTopic_Click" Padding="10,7" Margin="0,0,8,8"/>
                <Button x:Name="SolveTopicExerciseButton" Content="Resolver ejercicio asociado"
                        Click="SolveTopicExercise_Click" Padding="10,7" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Foreground="#476686" FontSize="11" TextWrapping="Wrap"
                Text="Los valores ilustrativos de A03 no son datos meteorológicos oficiales de diseño. Este esquema es educativo: los estados y límites se calculan a la presión seleccionada; no sustituye la carta de precisión de la Zona 1."/>
        </StackPanel>
    </Border>
</UserControl>
