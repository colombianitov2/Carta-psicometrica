<UserControl x:Class="FrioCalc.Psychrometrics.UI.ChartMetricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="18"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="8"
            Background="#FAFAFA">

        <StackPanel>

            <TextBlock Text="VARIABLES DE LA CARTA"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Seleccione las familias de líneas que desea mostrar."
                       TextWrapping="Wrap"
                       Foreground="#606060"
                       Margin="0,0,0,16"/>


            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Temperatura de bulbo seco (°C)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="DryBulbCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="DryBulbCheckBox_Changed"
                          Unchecked="DryBulbCheckBox_Changed"/>
            </Grid>


            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Humedad absoluta (g/kg aire seco)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="HumidityRatioCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="HumidityRatioCheckBox_Changed"
                          Unchecked="HumidityRatioCheckBox_Changed"/>
            </Grid>


            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Curva de saturación (100 % HR)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="SaturationCurveCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="SaturationCurveCheckBox_Changed"
                          Unchecked="SaturationCurveCheckBox_Changed"/>
            </Grid>


            <!-- Sección 5.3X.1 - Selector de entalpía -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Entalpía (kJ/kg aire seco)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="EnthalpyCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="EnthalpyCheckBox_Changed"
                          Unchecked="EnthalpyCheckBox_Changed"/>
            </Grid>

            <!-- Fin de sección 5.3X.1 -->


            <!-- Sección 5.3X.2 - Selector de humedad relativa -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Humedad relativa (%)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="RelativeHumidityCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="RelativeHumidityCheckBox_Changed"
                          Unchecked="RelativeHumidityCheckBox_Changed"/>
            </Grid>

            <!-- Fin de sección 5.3X.2 -->


            <!-- Sección 5.3X.3 - Selector de temperatura de bulbo húmedo -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Temperatura de bulbo húmedo (°C)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="WetBulbCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="WetBulbCheckBox_Changed"
                          Unchecked="WetBulbCheckBox_Changed"/>
            </Grid>

            <!-- Fin de sección 5.3X.3 -->


            <!-- Sección 5.3X.4 - Selector de volumen específico -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Volumen específico (m³/kg aire seco)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="SpecificVolumeCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="SpecificVolumeCheckBox_Changed"
                          Unchecked="SpecificVolumeCheckBox_Changed"/>
            </Grid>

            <!-- Fin de sección 5.3X.4 -->


            <!-- Sección 5.3X.5 - Selector de desviación de entalpía -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Desviación de entalpía (kJ/kg aire seco)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="EnthalpyDeviationCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="EnthalpyDeviationCheckBox_Changed"
                          Unchecked="EnthalpyDeviationCheckBox_Changed"/>
            </Grid>

            <!-- Fin de sección 5.3X.5 -->


            <Grid Margin="0,8,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Default"
                        Height="34"
                        Click="DefaultButton_Click"/>

                <Button Grid.Column="2"
                        Content="None"
                        Height="34"
                        Click="NoneButton_Click"/>

            </Grid>

        </StackPanel>

    </Border>

</UserControl>
