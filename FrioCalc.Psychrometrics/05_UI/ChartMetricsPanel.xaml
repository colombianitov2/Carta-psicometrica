<UserControl x:Class="FrioCalc.Psychrometrics.UI.ChartMetricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="18"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="8"
            Background="#FAFAFA">

        <StackPanel>

            <TextBlock Text="VARIABLES DE LA CARTA"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Seleccione las familias de líneas que desea mostrar."
                       TextWrapping="Wrap"
                       Foreground="#606060"
                       Margin="0,0,0,16"/>



            <!-- [5.3X.0] Entradas opcionales de estado y conversión de unidades -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Sistema de unidades" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="UnitsComboBox" Width="112" SelectionChanged="UnitsComboBox_SelectionChanged"
                          SelectedIndex="0">
                    <ComboBoxItem Content="SI"/>
                    <ComboBoxItem Content="IP"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="Método para resolver puntos" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="StateMethodComboBox" SelectedIndex="0" Margin="0,0,0,12">
                <ComboBoxItem Content="Automático: directo cuando sea posible" Tag="Automatic"/>
                <ComboBoxItem Content="Directo (requiere Tbs)" Tag="Direct"/>
                <ComboBoxItem Content="Iterativo: búsqueda de raíces" Tag="Iterative"/>
            </ComboBox>
            <TextBlock Text="Las casillas muestran curvas. Los valores escritos son restricciones del punto aunque su casilla esté apagada."
                       Foreground="#666666" TextWrapping="Wrap" FontSize="11"
                       Margin="0,0,0,12"/>

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="83"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="DryBulbLabel"
                           Text="Temperatura de bulbo seco (°C)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="DryBulbCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="DryBulbCheckBox_Changed"
                          Unchecked="DryBulbCheckBox_Changed"/>

                <TextBox x:Name="DryBulbInput" Grid.Column="2" Margin="8,0,0,0"
                         Height="26" VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="Entrada opcional para determinar el estado. La casilla solo controla la visualización."/>
            </Grid>


            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="83"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="HumidityRatioLabel"
                           Text="Humedad absoluta (g/kg aire seco)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="HumidityRatioCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="HumidityRatioCheckBox_Changed"
                          Unchecked="HumidityRatioCheckBox_Changed"/>

                <TextBox x:Name="HumidityRatioInput" Grid.Column="2" Margin="8,0,0,0"
                         Height="26" VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="Entrada opcional para determinar el estado. La casilla solo controla la visualización."/>
            </Grid>


            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Curva de saturación (100 % HR)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="SaturationCurveCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="SaturationCurveCheckBox_Changed"
                          Unchecked="SaturationCurveCheckBox_Changed"/>
            </Grid>


            <!-- Sección 5.3X.1 - Selector de entalpía -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="83"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="EnthalpyLabel"
                           Text="Entalpía (kJ/kg aire seco)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="EnthalpyCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="EnthalpyCheckBox_Changed"
                          Unchecked="EnthalpyCheckBox_Changed"/>

                <TextBox x:Name="EnthalpyInput" Grid.Column="2" Margin="8,0,0,0"
                         Height="26" VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="Entrada opcional para determinar el estado. La casilla solo controla la visualización."/>
            </Grid>

            <!-- Fin de sección 5.3X.1 -->


            <!-- Sección 5.3X.2 - Selector de humedad relativa -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="83"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="RelativeHumidityLabel"
                           Text="Humedad relativa (%)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="RelativeHumidityCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="RelativeHumidityCheckBox_Changed"
                          Unchecked="RelativeHumidityCheckBox_Changed"/>

                <TextBox x:Name="RelativeHumidityInput" Grid.Column="2" Margin="8,0,0,0"
                         Height="26" VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="Entrada opcional para determinar el estado. La casilla solo controla la visualización."/>
            </Grid>

            <!-- Fin de sección 5.3X.2 -->


            <!-- Sección 5.3X.3 - Selector de temperatura de bulbo húmedo -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="83"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="WetBulbLabel"
                           Text="Temperatura de bulbo húmedo (°C)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="WetBulbCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="WetBulbCheckBox_Changed"
                          Unchecked="WetBulbCheckBox_Changed"/>

                <TextBox x:Name="WetBulbInput" Grid.Column="2" Margin="8,0,0,0"
                         Height="26" VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="Entrada opcional para determinar el estado. La casilla solo controla la visualización."/>
            </Grid>

            <!-- Fin de sección 5.3X.3 -->


            <!-- Sección 5.3X.4 - Selector de volumen específico -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="83"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="SpecificVolumeLabel"
                           Text="Volumen específico (m³/kg aire seco)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="SpecificVolumeCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="SpecificVolumeCheckBox_Changed"
                          Unchecked="SpecificVolumeCheckBox_Changed"/>

                <TextBox x:Name="SpecificVolumeInput" Grid.Column="2" Margin="8,0,0,0"
                         Height="26" VerticalContentAlignment="Center" FontSize="12"
                         ToolTip="Entrada opcional para determinar el estado. La casilla solo controla la visualización."/>
            </Grid>

            <!-- Fin de sección 5.3X.4 -->


            <!-- Sección 5.3X.5 - Selector de desviación de entalpía -->

            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Desviación de entalpía (kJ/kg aire seco)"
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <CheckBox x:Name="EnthalpyDeviationCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="EnthalpyDeviationCheckBox_Changed"
                          Unchecked="EnthalpyDeviationCheckBox_Changed"/>
            </Grid>

            <!-- [5.3X.5.1] Familia independiente: entropía ideal relativa; no equivale a desviación de entalpía -->
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SpecificEntropyLabel" Text="Entropía específica relativa s* (kJ/(kg aire seco·K))"
                           TextWrapping="Wrap" FontSize="13.5" Margin="0,0,10,0" VerticalAlignment="Center"
                           ToolTip="Familia opcional adicional, modelo ideal. Referencia T=0 °C, p_da=101,325 kPa y p_v=0,611657 kPa."/>
                <CheckBox x:Name="SpecificEntropyCheckBox" Grid.Column="1" VerticalAlignment="Center"
                          Checked="SpecificEntropyCheckBox_Changed"
                          Unchecked="SpecificEntropyCheckBox_Changed"
                          ToolTip="No confundir con entalpía ni con la desviación de entalpía Carrier."/>
            </Grid>

            <!-- Fin de sección 5.3X.5 -->

            <!-- [5.3X.6] Punto de rocío: dato de estado, no familia gráfica independiente -->
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="83"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DewPointLabel" Grid.Column="0" Text="Punto de rocío (°C)"
                           FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="—" ToolTip="El punto de rocío comparte las líneas horizontales de W."
                           VerticalAlignment="Center"/>
                <TextBox x:Name="DewPointInput" Grid.Column="2" Height="26" Margin="8,0,0,0"
                         VerticalContentAlignment="Center" ToolTip="Condición opcional para resolver un punto."/>
            </Grid>
            <!-- [5.3X.7] Escala auxiliar del factor de calor sensible -->
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Factor de calor sensible (FCS)"
                           FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <CheckBox x:Name="SensibleHeatFactorCheckBox" Grid.Column="1"
                          Checked="SensibleHeatFactorCheckBox_Changed"
                          Unchecked="SensibleHeatFactorCheckBox_Changed" VerticalAlignment="Center"/>
            </Grid>



            <Grid Margin="0,8,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Default"
                        Height="34"
                        Click="DefaultButton_Click"/>

                <Button Grid.Column="2"
                        Content="None"
                        Height="34"
                        Click="NoneButton_Click"/>

            </Grid>

        </StackPanel>

    </Border>

</UserControl>
