<UserControl x:Class="FrioCalc.Psychrometrics.UI.PointPropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================== -->
    <!-- [5.4X.1] INICIO - Contenedor de propiedades del punto   -->
    <!-- ======================================================== -->

    <Border Padding="14"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="8"
            Background="#FAFAFA">

        <StackPanel>

            <TextBlock Text="PROPIEDADES DEL PUNTO"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>

            <TextBlock Text="Clic derecho sobre la carta para agregar o quitar un punto."
                       Foreground="#606060"
                       FontSize="12"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="EmptyStateTextBlock"
                       Text="No hay puntos seleccionados."
                       Foreground="#707070"
                       FontStyle="Italic"
                       Margin="0,4,0,4"/>

            <ScrollViewer MaxHeight="205"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <WrapPanel x:Name="PointsWrapPanel"
                           Orientation="Horizontal"/>

            </ScrollViewer>

        </StackPanel>

    </Border>

    <!-- ======================================================== -->
    <!-- [5.4X.1] FIN - Contenedor de propiedades del punto      -->
    <!-- ======================================================== -->

</UserControl>
