<UserControl x:Class="FrioCalc.Psychrometrics.UI.ProcessTheoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [5.5X.1] Laboratorio didáctico interactivo, esquema calculado y no escala ASHRAE -->
    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14"
            Background="#F8FAFC" Margin="0,0,0,18">
        <StackPanel>
            <TextBlock Text="LABORATORIO INTERACTIVO DE PROCESOS" FontWeight="SemiBold"
                       FontSize="17" Margin="0,0,0,8"/>
            <TextBlock Text="Demostración calculada, a presión fija y con hipótesis expresas. No sustituye el diseño del equipo ni la carta principal."
                       TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,12"/>
            <TextBlock Text="Tipo de transformación" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="ProcessSelector" SelectionChanged="ControlsChanged" SelectedIndex="0"
                      Height="30" Margin="0,0,0,10">
                <ComboBoxItem Content="Calefacción sensible" Tag="Heating"/>
                <ComboBoxItem Content="Enfriamiento sensible" Tag="Cooling"/>
                <ComboBoxItem Content="Humidificación evaporativa ideal" Tag="Evaporative"/>
                <ComboBoxItem Content="Humidificación mediante vapor" Tag="Steam"/>
                <ComboBoxItem Content="Enfriamiento y deshumidificación" Tag="Dehumidification"/>
                <ComboBoxItem Content="Mezcla de dos corrientes" Tag="Mixing"/>
            </ComboBox>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DryBulbValueLabel" Text="Tbs inicial: 25 °C"/>
                    <Slider x:Name="DryBulbSlider" Minimum="5" Maximum="40" Value="25"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="ControlsChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="RelativeHumidityValueLabel" Text="HR inicial: 50 %"/>
                    <Slider x:Name="HumiditySlider" Minimum="10" Maximum="90" Value="50"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="ControlsChanged"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ParameterLabel" Text="Intensidad del proceso: 50 %" Margin="0,0,0,3"/>
            <Slider x:Name="ParameterSlider" Minimum="0" Maximum="100" Value="50"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="ControlsChanged" Margin="0,0,0,10"/>
            <TextBlock x:Name="TheoryExplanation" TextWrapping="Wrap" FontSize="12"
                       Margin="0,0,0,9"/>
            <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White"
                    CornerRadius="4" Margin="0,0,0,9">
                <Canvas x:Name="DiagramCanvas" Width="720" Height="300" HorizontalAlignment="Left"
                        SizeChanged="DiagramCanvas_SizeChanged"/>
            </Border>
            <TextBlock x:Name="TheoryValues" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,7"/>
            <TextBlock Text="Fuente metodológica: ASHRAE Handbook—Fundamentals (Psychrometrics); contrastes PsychroLib y CoolProp. Para mezclas, balance ideal sin condensación."
                       Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>