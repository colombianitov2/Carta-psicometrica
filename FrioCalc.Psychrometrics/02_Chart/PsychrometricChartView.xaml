<UserControl x:Class="FrioCalc.Psychrometrics.Chart.PsychrometricChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Carta psicrométrica"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="PressureValueText"
                       Grid.Column="1"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#444444"
                       VerticalAlignment="Center"/>

        </Grid>


        <!-- Sección 2.1X.2 - Carta y barras de desplazamiento -->

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Border Grid.Row="0"
                    Grid.Column="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Background="#F6F6F6">

                <Canvas x:Name="ChartCanvas"
                        Background="#F6F6F6"
                        Cursor="Hand"
                        MouseWheel="ChartCanvas_MouseWheel"
                        MouseLeftButtonDown="ChartCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="ChartCanvas_MouseLeftButtonUp"
                        MouseRightButtonDown="ChartCanvas_MouseRightButtonDown"
                        MouseMove="ChartCanvas_MouseMove"
                        LostMouseCapture="ChartCanvas_LostMouseCapture"/>

            </Border>


            <ScrollBar x:Name="HorizontalChartScrollBar"
                       Grid.Row="1"
                       Grid.Column="0"
                       Orientation="Horizontal"
                       Height="17"
                       Margin="50,9,95,0"
                       ValueChanged="HorizontalChartScrollBar_ValueChanged"/>


            <ScrollBar x:Name="VerticalChartScrollBar"
                       Grid.Row="0"
                       Grid.Column="1"
                       Orientation="Vertical"
                       Width="17"
                       Margin="11,30,0,90"
                       ValueChanged="VerticalChartScrollBar_ValueChanged"/>

        </Grid>

        <!-- Fin de sección 2.1X.2 -->

    </Grid>

</UserControl>