                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16" MaxWidth="1100">
                        <TextBlock Text="BIBLIOGRAFÍA" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
