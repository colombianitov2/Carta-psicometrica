<Window x:Class="FrioCalc.Psychrometrics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FrioCalc.Psychrometrics.UI"
        xmlns:chart="clr-namespace:FrioCalc.Psychrometrics.Chart"
        Title="FrioCalc — Psicrometría y procesos" Width="1460" Height="850"
        MinWidth="940" MinHeight="600" WindowStartupLocation="CenterScreen">
    <!-- [5.1X.1] Dos zonas: carta y procesos (Zona 1), teoría (Zona 2). -->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="335" MaxWidth="365"/>
            <ColumnDefinition x:Name="SettingsGapColumn" Width="9"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- [5.1X.2] Controles de presión, unidades y propiedades -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ui:PressureSelector x:Name="PressureSelector" Margin="0,0,0,12"/>
                <ui:ChartMetricsPanel x:Name="ChartMetricsPanel"/>
            </StackPanel>
        </ScrollViewer>
        <TabControl Grid.Column="2" x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_SelectionChanged">
            <!-- [5.1X.3] Carta original conservada + panel de puntos -->
            <TabItem Header="Carta psicrométrica">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="280"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="225" MinHeight="100"/>
                    </Grid.RowDefinitions>
                    <chart:PsychrometricChartView x:Name="PsychrometricChart" Grid.Row="0"/>
                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" ResizeDirection="Rows"
                                  Background="#E2E8F0"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ui:PointPropertiesPanel x:Name="PointPropertiesPanel"/>
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6"
                                Background="#FAFAFA" Margin="0,6,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="PROPIEDADES DEL PROCESO" FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <ScrollViewer MaxHeight="115" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="SelectedProcessSummaryMainText" FontSize="12"
                                               Text="Todavía no hay un proceso calculado."
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- [5.1X.4] Segunda carta para procesos múltiples -->
            <TabItem Header="Procesos">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <chart:PsychrometricChartView x:Name="ProcessChart" Grid.Row="0" Visibility="Collapsed"/>
                    <GridSplitter Grid.Row="1" Visibility="Collapsed" Height="0" HorizontalAlignment="Stretch" />
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ProcessPressureIndicator" Text="Presión: 101,325 kPa absolutos" TextWrapping="Wrap" Foreground="#53677B" Margin="0,0,0,8"/>
                            <TextBlock Text="CONSTRUIR PROCESO" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="La carta principal muestra estados y trayectorias. Aquí se editan parámetros, tablas y balances."
                                       FontSize="12" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,9" Visibility="Collapsed">
                                <CheckBox x:Name="ProcessEnthalpyToggle" Content="Entalpía"
                                          Checked="ProcessFamilyVisibility_Changed" Unchecked="ProcessFamilyVisibility_Changed"
                                          Margin="0,0,12,4"/>
                                <CheckBox x:Name="ProcessWetBulbToggle" Content="Bulbo húmedo"
                                          Checked="ProcessFamilyVisibility_Changed" Unchecked="ProcessFamilyVisibility_Changed"
                                          Margin="0,0,12,4"/>
                                <CheckBox x:Name="ProcessSpecificVolumeToggle" Content="Volumen específico"
                                          Checked="ProcessFamilyVisibility_Changed" Unchecked="ProcessFamilyVisibility_Changed"
                                          Margin="0,0,12,4"/>
                                <CheckBox x:Name="ProcessRelativeHumidityToggle" Content="HR"
                                          IsChecked="True"
                                          Checked="ProcessFamilyVisibility_Changed" Unchecked="ProcessFamilyVisibility_Changed"
                                          Margin="0,0,12,4"/>
                            </WrapPanel>
                            <TextBlock Text="Seleccione puntos en Carta psicrométrica, en orden. Para mezclas seleccione dos entradas."
                                       TextWrapping="Wrap" FontSize="12" Foreground="#666"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Secuencia seleccionada" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ListBox x:Name="ProcessSelectionList" Height="90" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Subir" Width="78" Click="MovePointUp_Click" Margin="0,0,8,0"/>
                                <Button Content="Bajar" Width="78" Click="MovePointDown_Click" Margin="0,0,8,0"/>
                            </StackPanel>
                            <Border BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="5"
                                    Padding="8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="GUÍA DE FACTOR DE CALOR SENSIBLE"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBlock Text="Introduzca FCS entre 0 y 1 y seleccione el estado de referencia. La línea no determina por sí sola el punto de impulsión."
                                               TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="FcsGuideTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Dibujar guía" Click="DrawFcsGuide_Click" Padding="6" Margin="0,0,5,0"/>
                                        <Button Content="Quitar guía" Click="ClearFcsGuide_Click" Padding="6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Método / tipo de proceso" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="ProcessTypeComboBox" SelectedIndex="0" Margin="0,0,0,10">
                                <ComboBoxItem Content="Automático · diferencias entre estados" Tag="Automatic"/>
                                <ComboBoxItem Content="Calefacción o enfriamiento sensible" Tag="Sensible"/>
                                <ComboBoxItem Content="Calentamiento y humidificación" Tag="HeatingHumidification"/>
                                <ComboBoxItem Content="Enfriamiento y deshumidificación" Tag="CoolingDehumidification"/>
                                <ComboBoxItem Content="Humidificación por vapor" Tag="SteamHumidification"/>
                                <ComboBoxItem Content="Humidificación evaporativa" Tag="EvaporativeHumidification"/>
                                <ComboBoxItem Content="Deshumidificación con desecante" Tag="Desiccant"/>
                                <ComboBoxItem Content="Mezcla adiabática" Tag="AdiabaticMixing"/>
                                <ComboBoxItem Content="Factor de bypass / ADP" Tag="Bypass"/>
                                <ComboBoxItem Content="Divisor con dos ramas y estados conocidos" Tag="Branching"/>
                            </ComboBox>
                            <TextBlock Text="Caudal másico de aire seco, kg/s (opcional salvo donde se requiera)"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="DryFlowTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            <TextBlock Text="Temperatura del condensado para balance del serpentín (°C, opcional)"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="CondensateTemperatureTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            <TextBlock Text="Mezcla de N entradas: caudales m³/h separados por punto y coma (opcional)"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="MixFlowsListTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            <TextBlock Text="Alternativa para mezcla de solo dos entradas:" FontWeight="SemiBold"
                                       FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="Solo para mezcla: caudal de entrada 1, m³/h" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="MixFlowFirstTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock Text="Solo para mezcla: caudal de entrada 2, m³/h" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="MixFlowSecondTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,10"/>
                            <TextBlock Text="División en 2 ramas: fracción de flujo hacia rama 1 (0–1)" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBox x:Name="BranchFractionTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"
                                     ToolTip="Seleccione primero entrada, luego salidas de rama 1 y rama 2. Requiere flujo másico total."/>
                            <TextBlock Text="Para salida predictiva con un punto de entrada"
                                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="Efectividad evaporativa ε (0–1)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="EffectivenessTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock Text="ADP o punto de rocío del aparato (°C)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="ApparatusDewPointTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock Text="Factor de bypass BF (0–1)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="BypassFactorTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock Text="Vapor añadido (g/kg aire seco)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="SteamAddedTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock Text="Entalpía del vapor inyectado (kJ/kg de vapor)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="SteamEnthalpyTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,10"/>
                            <TextBlock Text="Desecante: humedad retirada (g/kg aire seco)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="DesiccantRemovedTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock Text="Desecante: bulbo seco medido o especificado a la salida (°C)" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBox x:Name="DesiccantTemperatureTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            <TextBlock Text="Estos métodos generan un estado de salida usando exactamente los datos del equipo indicados. No hay parámetros predeterminados ocultos."
                                       TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,0,0,9"/>
                            <CheckBox x:Name="CloseCycleCheckBox" Content="Cerrar recorrido regresando al punto inicial (método automático)"
                                      ToolTip="Se conserva el orden de los estados; cierra el polígono y verifica el balance del recorrido."
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Nombre del nuevo proceso (opcional)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="NewProcessNameTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            <Button Content="GRAFICAR PROCESO" Padding="8" FontWeight="SemiBold"
                                    Click="PlotProcess_Click" Margin="0,0,0,10"/>
                            <TextBlock Text="Procesos guardados" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ListBox x:Name="SavedProcessesList" Height="95" Margin="0,0,0,7"
                                     SelectionChanged="SavedProcessesList_SelectionChanged"/>
                            <TextBlock Text="Nombre para renombrar el proceso seleccionado" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBox x:Name="RenameProcessTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Renombrar" Click="RenameProcess_Click"
                                        Padding="6" Margin="0,0,6,0"/>
                                <Button Content="Mostrar / ocultar" Click="ToggleProcessVisibility_Click" Padding="6"/>
                            </StackPanel>
                            <Button Content="Cargar para editar" Click="EditProcess_Click"
                                    Padding="6" Margin="0,0,0,7"/>
                            <Button Content="Deshacer última acción" Click="UndoLastAction_Click"
                                    Padding="6" Margin="0,0,0,7"/>
                            <Button Content="Eliminar proceso seleccionado" Click="DeleteProcess_Click"
                                    Padding="6" Margin="0,0,0,9"/>
                            <TextBlock Text="RESULTADOS Y ADVERTENCIAS" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ProcessResultText" Text="Seleccione al menos dos puntos."
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                <Button Content="Guardar sesión JSON" Click="SaveSession_Click"
                                        Padding="5" Margin="0,0,7,0"/>
                                <Button Content="Abrir sesión JSON" Click="LoadSession_Click" Padding="5"/>
                            </StackPanel>
                            <Button Content="Exportar informe Markdown (.md)" Click="ExportMarkdownReport_Click"
                                    Padding="7" Margin="0,0,0,6"/>
                            <Button Content="Exportar carta principal con procesos PNG" Click="ExportChartPng_Click"
                                    Padding="7" Margin="0,0,0,6"/>
                            <Button Content="Exportar informe CSV" Click="ExportReport_Click"
                                    Padding="7"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- [5.1X.5] Zona 2: teoría según diapositivas 1-24 de A03 -->
            <TabItem Header="Teoría y fundamentos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" MaxWidth="1100" HorizontalAlignment="Stretch">
                        <TextBlock Text="FUNDAMENTOS DE PSICROMETRÍA — ASHRAE"
                                   FontSize="23" FontWeight="Bold" Margin="0,0,0,15"/>
                        <TextBlock Text="Estudio técnico en el orden de ASHRAE: composición, termodinámica, humedad, construcción de la carta y procesos. Incluye ecuaciones deducidas, origen de sus constantes y ejemplos calculados."
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>
                        <TextBlock Text="Propiedades del aire húmedo" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Tbs: temperatura de bulbo seco. Tbh: temperatura de bulbo húmedo termodinámico. Trocío: temperatura de condensación. HR: humedad relativa (%). W: masa de vapor de agua por masa de aire seco. h: entalpía por masa de aire seco. v: volumen por masa de aire seco. P: presión absoluta."
                                   TextWrapping="Wrap" Margin="0,5,0,15"/>
                        <ui:AshraeStudyPanel x:Name="AshraeStudyPanel" HorizontalAlignment="Stretch"/>
                        <ui:TheoryCoursePanel x:Name="TheoryCoursePanel" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                        <ui:ProcessTheoryPanel x:Name="ProcessTheoryPanel" HorizontalAlignment="Stretch"/>
                        <ui:BibliographyPanel x:Name="BibliographyPanel" HorizontalAlignment="Stretch"/>
                        <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Nota técnica: en los controles se conserva «Humedad absoluta» como etiqueta solicitada, pero W en g/kg de aire seco es la razón de humedad. La humedad absoluta volumétrica tiene unidades kg de vapor/m³."
                                   TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,12"/>
                        <TextBlock Text="1. Calefacción y enfriamiento sensible (diapositivas 3–7)"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Se modifica Tbs sin variar W. La diferencia de entalpía se convierte en potencia si se conoce el flujo másico de aire seco: Q̇ = ṁda·(h2−h1). No confundir caudal volumétrico con caudal másico."
                                   TextWrapping="Wrap" Margin="0,4,0,9"/>
                        <Button Content="Cargar ejemplo: 35 °C y W=10 g/kg" Click="ExampleCooling_Click"
                                HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,17"/>
                        <TextBlock Text="2. Humidificación y deshumidificación (diapositivas 8–15)"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="La inyección de vapor agrega masa de agua y entalpía; su aporte energético depende de la entalpía del vapor. La evaporación adiabática puede disminuir Tbs a la vez que aumenta W. La deshumidificación por serpentín exige balance energético y de agua condensada. Para desecantes se requieren propiedades y rendimiento del material."
                                   TextWrapping="Wrap" Margin="0,4,0,9"/>
                        <Button Content="Cargar ejemplo: 30 °C y 10 % HR" Click="ExampleHumidifier_Click"
                                HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,17"/>
                        <TextBlock Text="3. Procesos combinados (diapositivas 16–21)"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Calentamiento+humidificación, enfriamiento+deshumidificación y mezcla adiabática son secuencias o balances de múltiples corrientes. En mezcla se conservan ṁda, ṁda·W y ṁda·h; no es válido promediar directamente caudales volumétricos."
                                   TextWrapping="Wrap" Margin="0,4,0,17"/>
                        <TextBlock Text="4. Ejercicios de las diapositivas 22–24 y 32–36" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Auditorio: 300 personas y 8 L/s por persona; para la carga total se necesitan estados y un modelo de flujos/cargas. UTA: 3000 m³/h de retorno y 500 m³/h de aire exterior, convertir cada volumen por su propio volumen específico. FCS interior 0,75 y BF 0,2 no determinan por sí solos un estado único de impulsión sin datos suficientes del serpentín y cargas."
                                   TextWrapping="Wrap" Margin="0,4,0,16"/>
                        <TextBlock Text="5. Climatización, serpentín, ADP, bypass y RSHF/GSHF (diapositivas 25–36)"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBlock Text="La segunda parte de A03 incorpora climatización en climas cálidos/fríos, diferencias entre cargas del local y del sistema, punto de rocío de aparato (ADP), factor de bypass (BF), aire exterior/retorno, ventilador después del serpentín y un ejercicio completo con agua fría. Consulte cada diapositiva en el curso navegable. Las condiciones climáticas son ilustraciones docentes, no datos de diseño certificados."
                                   TextWrapping="Wrap" Margin="0,4,0,17"/>
                        <TextBlock Text="EJERCICIOS RESUELTOS DESDE EL MOTOR (A03)"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Diapo 6" Tag="6" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                            <Button Content="Diapo 7" Tag="7" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                            <Button Content="Diapo 14" Tag="14" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                            <Button Content="Diapo 15" Tag="15" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                            <Button Content="Diapo 22" Tag="22" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                            <Button Content="Diapo 23" Tag="23" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                            <Button Content="Diapo 24" Tag="24" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                             <Button Content="Diapo 32" Tag="32" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                             <Button Content="Diapo 36" Tag="36" Click="ComputeSlideExample_Click" Padding="9,5" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <Border Padding="14" BorderBrush="#CCD0D4" BorderThickness="1"
                                CornerRadius="6" Background="#FAFAFA" Margin="0,0,0,18">
                            <TextBlock x:Name="TheoryExampleResultText"
                                       Text="Seleccione una diapositiva para resolverla con la presión activa."
                                       FontFamily="Consolas" TextWrapping="Wrap" FontSize="13"/>
                        </Border>
                        <TextBlock Text="Fuentes: ASHRAE 2025 Handbook—Fundamentals, cap. 1; PsychroLib (psychrometrics.github.io/psychrolib); CoolProp (coolprop.org/fluid_properties/HumidAir.html). El término 'rendimiento de Hendrickson' de la presentación requiere corroboración terminológica antes de publicarse como norma."
                                   TextWrapping="Wrap" Foreground="#444"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
