                        </ItemsControl>
                        <TextBlock Text="Material docente de procesos psicrométricos" FontWeight="SemiBold" Margin="0,18,0,5"/>
                        <TextBlock Text="Procesos psicrométricos — Hermes Ramírez León" TextWrapping="Wrap"/>
