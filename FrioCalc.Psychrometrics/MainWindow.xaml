<Window x:Class="FrioCalc.Psychrometrics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FrioCalc.Psychrometrics.UI"
        xmlns:chart="clr-namespace:FrioCalc.Psychrometrics.Chart"
        Title="Calculadora de refrigeración – Parte 1 – Carta psicrométrica" Width="1460" Height="850"
        MinWidth="940" MinHeight="600" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ProcessPointItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style x:Key="AvailableProcessPointItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ProcessPointItemStyle}">
            <Setter Property="Width" Value="270"/>
        </Style>
        <DataTemplate x:Key="ProcessPointCardTemplate">
            <Border BorderBrush="{Binding Color}" BorderThickness="1.2" CornerRadius="5" Padding="9" Background="White" MinWidth="110">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Ellipse Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Bulbo seco:" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,7,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DryBulb}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
                            <TextBlock Grid.Row="1" Text="Humedad absoluta:" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,7,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Humidity}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
                            <TextBlock Grid.Row="2" Text="Humedad relativa:" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,7,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RelativeHumidity}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
                            <TextBlock Grid.Row="3" Text="Bulbo húmedo:" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,7,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WetBulb}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
                            <TextBlock Grid.Row="4" Text="Punto de rocío:" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,7,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DewPoint}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
                            <TextBlock Grid.Row="5" Text="Entalpía:" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,7,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Enthalpy}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
                            <TextBlock Grid.Row="6" Text="Volumen específico:" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,7,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Volume}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
                            <TextBlock Grid.Row="7" Text="Entropía relativa:" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,7,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Entropy}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <!-- [5.1X.1] Dos zonas: carta y procesos (Zona 1), teoría (Zona 2). -->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="335" MaxWidth="365"/>
            <ColumnDefinition x:Name="SettingsGapColumn" Width="9"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- [5.1X.2] Controles de presión, unidades y propiedades -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ui:PressureSelector x:Name="PressureSelector" Margin="0,0,0,12"/>
                <ui:ChartMetricsPanel x:Name="ChartMetricsPanel"/>
            </StackPanel>
        </ScrollViewer>
        <TabControl Grid.Column="2" x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabs_SelectionChanged">
            <!-- [5.1X.3] Carta original conservada + panel de puntos -->
            <TabItem Header="Carta psicrométrica">
                <ScrollViewer x:Name="ChartPageScroll" Margin="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ChartPageScroll_SizeChanged">
                    <StackPanel>
                        <chart:PsychrometricChartView x:Name="PsychrometricChart" Height="520" Margin="0,0,0,8"/>
                        <ui:PointPropertiesPanel x:Name="PointPropertiesPanel"/>
                        <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6"
                                Background="#FAFAFA" Margin="0,6,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="PROPIEDADES DEL PROCESO" FontWeight="SemiBold" FontSize="14"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="SelectedProcessSummaryMainText" FontSize="12"
                                           Text="Todavía no hay un proceso calculado." Visibility="Collapsed"
                                           TextWrapping="Wrap"/>
                                <StackPanel x:Name="MainProcessResultsPanel"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- [5.1X.4] Segunda carta para procesos múltiples -->
            <TabItem Header="Procesos">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <chart:PsychrometricChartView x:Name="ProcessChart" Grid.Row="0" Visibility="Collapsed"/>
                    <GridSplitter Grid.Row="1" Visibility="Collapsed" Height="0" HorizontalAlignment="Stretch" />
                    <ScrollViewer x:Name="ProcessPageScroll" Grid.Row="2" Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                                  VerticalScrollBarVisibility="Auto" AllowDrop="True" Drop="ProcessPage_Drop">
                        <StackPanel>
                            <TextBlock x:Name="ProcessPressureIndicator" Text="Presión: 101,325 kPa absolutos" TextWrapping="Wrap" Foreground="#53677B" Margin="0,0,0,8"/>
                            <StackPanel x:Name="ProcessBuilderView">
                            <TextBlock Text="CONSTRUIR PROCESO" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Arrastre los estados a un grupo para añadirlos, incluso si ya aparecen en él. Mueva las tarjetas del grupo para reordenarlas o suéltelas fuera del recuadro para retirarlas. Los puntos de la carta se conservan." FontSize="12" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,12"/>
                            <WrapPanel Margin="0,0,0,9" Visibility="Collapsed">
                                <CheckBox x:Name="ProcessEnthalpyToggle" Content="Entalpía"
                                          Checked="ProcessFamilyVisibility_Changed" Unchecked="ProcessFamilyVisibility_Changed"
                                          Margin="0,0,12,4"/>
                                <CheckBox x:Name="ProcessWetBulbToggle" Content="Bulbo húmedo"
                                          Checked="ProcessFamilyVisibility_Changed" Unchecked="ProcessFamilyVisibility_Changed"
                                          Margin="0,0,12,4"/>
                                <CheckBox x:Name="ProcessSpecificVolumeToggle" Content="Volumen específico"
                                          Checked="ProcessFamilyVisibility_Changed" Unchecked="ProcessFamilyVisibility_Changed"
                                          Margin="0,0,12,4"/>
                                <CheckBox x:Name="ProcessRelativeHumidityToggle" Content="HR"
                                          IsChecked="True"
                                          Checked="ProcessFamilyVisibility_Changed" Unchecked="ProcessFamilyVisibility_Changed"
                                          Margin="0,0,12,4"/>
                            </WrapPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Puntos disponibles" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ListBox x:Name="AvailablePointsList" MinHeight="120" ItemTemplate="{StaticResource ProcessPointCardTemplate}" ItemContainerStyle="{StaticResource AvailableProcessPointItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                                             PreviewMouseLeftButtonDown="ProcessList_MouseDown" PreviewMouseMove="ProcessList_MouseMove"
                                             Drop="AvailablePoints_Drop" MouseDoubleClick="AvailablePoints_DoubleClick">
                                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button x:Name="AddProcessGroupButton" DockPanel.Dock="Right" Content="+" Width="34" Height="32" FontSize="20" ToolTip="Crear un grupo de procesos" Click="NewProcessGroup_Click"/>
                                        <TextBlock Text="Lista de procesos" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ProcessBuilderStatus" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="ProcessCardsPanel"/>
                                </StackPanel>
                            </Grid>
                            <Button Visibility="Collapsed" Content="Deshacer última acción" Click="UndoLastAction_Click" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,6"/>
                            <Button Content="Exportar informe Word (.docx)" Click="ExportWordReport_Click" HorizontalAlignment="Left" Padding="12,8" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="ProcessEditor" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Volver sin guardar" Click="CloseProcessEditor_Click" Padding="8,5"/>
                                <TextBlock x:Name="ProcessEditorHeading" Text="Editar grupo de procesos" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,12" x:Name="SequenceEditor">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Puntos disponibles" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ListBox x:Name="EditorAvailablePointsList" MinHeight="110" ItemTemplate="{StaticResource ProcessPointCardTemplate}" ItemContainerStyle="{StaticResource ProcessPointItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" PreviewMouseLeftButtonDown="ProcessList_MouseDown" PreviewMouseMove="ProcessList_MouseMove" Drop="AvailablePoints_Drop" MouseDoubleClick="AvailablePoints_DoubleClick"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Orden del grupo" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ListBox x:Name="ProcessSelectionList" MinHeight="110" ItemTemplate="{StaticResource ProcessPointCardTemplate}" ItemContainerStyle="{StaticResource ProcessPointItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" PreviewMouseLeftButtonDown="ProcessList_MouseDown" PreviewMouseMove="ProcessList_MouseMove" Drop="ProcessSequence_Drop" MouseDoubleClick="ProcessSequence_DoubleClick"/>
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="5"
                                    Padding="8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="GUÍA DE FACTOR DE CALOR SENSIBLE"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBlock Text="Introduzca FCS entre 0 y 1 y seleccione el estado de referencia. La línea no determina por sí sola el punto de impulsión."
                                               TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="FcsGuideTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Dibujar guía" Click="DrawFcsGuide_Click" Padding="6" Margin="0,0,5,0"/>
                                        <Button Content="Quitar guía" Click="ClearFcsGuide_Click" Padding="6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Método / tipo de proceso" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="ProcessTypeComboBox" SelectedIndex="0" Width="385" HorizontalAlignment="Left" SelectionChanged="ProcessType_Changed" Margin="0,0,0,10">
                                <ComboBoxItem Content="Automático · diferencias entre estados" Tag="Automatic"/>
                                <ComboBoxItem Content="Calefacción o enfriamiento sensible" Tag="Sensible"/>
                                <ComboBoxItem Content="Calentamiento y humidificación" Tag="HeatingHumidification"/>
                                <ComboBoxItem Content="Enfriamiento y deshumidificación" Tag="CoolingDehumidification"/>
                                <ComboBoxItem Content="Humidificación por vapor" Tag="SteamHumidification"/>
                                <ComboBoxItem Content="Humidificación evaporativa" Tag="EvaporativeHumidification"/>
                                <ComboBoxItem Content="Deshumidificación con desecante" Tag="Desiccant"/>
                                <ComboBoxItem Content="Mezcla adiabática" Tag="AdiabaticMixing"/>
                                <ComboBoxItem Content="Factor de bypass / ADP" Tag="Bypass"/>
                                <ComboBoxItem Content="Divisor con dos ramas y estados conocidos" Tag="Branching"/>
                            </ComboBox>
                            <StackPanel x:Name="SegmentEditorsPanel" Margin="0,0,0,10"/>
                            <TextBlock x:Name="DryFlowLabel" Text="Caudal másico de aire seco, kg/s (opcional salvo donde se requiera)"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="DryFlowTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            <StackPanel x:Name="CondensateGroup" Visibility="Collapsed">
                             <TextBlock x:Name="CondensateTemperatureLabel" Text="Temperatura del condensado para balance del serpentín (°C, opcional)"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="CondensateTemperatureTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            </StackPanel>
                             <StackPanel x:Name="MixingGroup" Visibility="Collapsed">
                             <TextBlock x:Name="MixFlowsLabel" Text="Mezcla de N entradas: caudales m³/h separados por punto y coma (opcional)"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="MixFlowsListTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            <TextBlock Text="Alternativa para mezcla de solo dos entradas:" FontWeight="SemiBold"
                                       FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MixFlowFirstLabel" Text="Solo para mezcla: caudal de entrada 1, m³/h" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="MixFlowFirstTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock x:Name="MixFlowSecondLabel" Text="Solo para mezcla: caudal de entrada 2, m³/h" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="MixFlowSecondTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,10"/>
                            </StackPanel>
                             <StackPanel x:Name="BranchingGroup" Visibility="Collapsed">
                             <TextBlock Text="División en 2 ramas: fracción de flujo hacia rama 1 (0–1)" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBox x:Name="BranchFractionTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"
                                     ToolTip="Seleccione primero entrada, luego salidas de rama 1 y rama 2. Requiere flujo másico total."/>
                            </StackPanel>
                             <TextBlock x:Name="PredictiveNotice" Visibility="Collapsed" Text="Para salida predictiva con un punto de entrada"
                                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <StackPanel x:Name="EffectivenessGroup" Visibility="Collapsed">
                             <TextBlock Text="Efectividad evaporativa ε (0–1)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="EffectivenessTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            </StackPanel>
                             <StackPanel x:Name="BypassGroup" Visibility="Collapsed">
                             <TextBlock x:Name="ApparatusDewPointLabel" Text="ADP o punto de rocío del aparato (°C)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="ApparatusDewPointTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock Text="Factor de bypass BF (0–1)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="BypassFactorTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            </StackPanel>
                             <StackPanel x:Name="SteamGroup" Visibility="Collapsed">
                             <TextBlock x:Name="SteamAddedLabel" Text="Vapor añadido (g/kg aire seco)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="SteamAddedTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock x:Name="SteamEnthalpyLabel" Text="Entalpía del vapor inyectado (kJ/kg de vapor)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="SteamEnthalpyTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,10"/>
                            </StackPanel>
                             <StackPanel x:Name="DesiccantGroup" Visibility="Collapsed">
                            <TextBlock x:Name="DesiccantRemovedLabel" Text="Desecante: humedad retirada (g/kg aire seco)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="DesiccantRemovedTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,6"/>
                            <TextBlock x:Name="DesiccantTemperatureLabel" Text="Desecante: bulbo seco medido o especificado a la salida (°C)" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBox x:Name="DesiccantTemperatureTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            </StackPanel>
                             <TextBlock x:Name="PredictiveExplanation" Visibility="Collapsed" Text="Estos métodos generan un estado de salida usando exactamente los datos del equipo indicados. No hay parámetros predeterminados ocultos."
                                       TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,0,0,9"/>
                            <CheckBox x:Name="CloseCycleCheckBox" Content="Añadir retorno al punto inicial al guardar, si el recorrido aún está abierto"
                                      ToolTip="Se conserva el orden de los estados; cierra el polígono y verifica el balance del recorrido."
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Nombre del nuevo proceso (opcional)" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="NewProcessNameTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,8"/>
                            <ListBox x:Name="SavedProcessesList" Visibility="Collapsed"
                                     SelectionChanged="SavedProcessesList_SelectionChanged"/>
                            <TextBlock Text="Nombre para renombrar el proceso seleccionado" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBox x:Name="RenameProcessTextBox" Width="245" HorizontalAlignment="Left" Height="27" Margin="0,0,0,7"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Renombrar" Click="RenameProcess_Click"
                                        Padding="6" Margin="0,0,6,0"/>
                                <Button Content="Mostrar / ocultar" Click="ToggleProcessVisibility_Click" Padding="6"/>
                            </StackPanel>
                            <Button Content="Restaurar datos guardados" Click="EditProcess_Click"
                                    Padding="6" Margin="0,0,0,7"/>
                            <Button Content="Deshacer última acción" Click="UndoLastAction_Click"
                                    Padding="6" Margin="0,0,0,7"/>
                            <Button Content="Eliminar proceso seleccionado" Click="DeleteProcess_Click"
                                    Padding="6" Margin="0,0,0,9"/>
                            <TextBlock Text="Resultados del grupo" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ProcessResultText" Text="Seleccione al menos dos puntos." Visibility="Collapsed"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                            <StackPanel x:Name="ProcessResultsPanel"/>
                            <Button x:Name="SaveProcessGroupButton" Content="Guardar y volver" Padding="12,8" FontWeight="SemiBold" HorizontalAlignment="Left" Click="PlotProcess_Click" Margin="0,12,0,12"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- [5.1X.5] Zona 2: teoría según diapositivas 1-24 de A03 -->
            <TabItem Header="Fundamentos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" MaxWidth="1100" HorizontalAlignment="Stretch">
                        <ui:AshraeStudyPanel x:Name="AshraeStudyPanel" HorizontalAlignment="Stretch"/>
                        <ui:TheoryCoursePanel x:Name="TheoryCoursePanel" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                        <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Nota técnica: en los controles se conserva «Humedad absoluta» como etiqueta solicitada, pero W en g/kg de aire seco es la razón de humedad. La humedad absoluta volumétrica tiene unidades kg de vapor/m³."
                                   TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,12"/>
                        <TextBlock Text="1. Calefacción y enfriamiento sensible (diapositivas 3–7)"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Se modifica Tbs sin variar W. La diferencia de entalpía se convierte en potencia si se conoce el flujo másico de aire seco: Q̇ = ṁda·(h2−h1). No confundir caudal volumétrico con caudal másico."
                                   TextWrapping="Wrap" Margin="0,4,0,9"/>
                        <Button Content="Cargar ejemplo: 35 °C y W=10 g/kg" Click="ExampleCooling_Click"
                                HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,17"/>
                        <TextBlock Text="2. Humidificación y deshumidificación (diapositivas 8–15)"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="La inyección de vapor agrega masa de agua y entalpía; su aporte energético depende de la entalpía del vapor. La evaporación adiabática puede disminuir Tbs a la vez que aumenta W. La deshumidificación por serpentín exige balance energético y de agua condensada. Para desecantes se requieren propiedades y rendimiento del material."
                                   TextWrapping="Wrap" Margin="0,4,0,9"/>
                        <Button Content="Cargar ejemplo: 30 °C y 10 % HR" Click="ExampleHumidifier_Click"
                                HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,17"/>
                        <TextBlock Text="3. Procesos combinados (diapositivas 16–21)"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Calentamiento+humidificación, enfriamiento+deshumidificación y mezcla adiabática son secuencias o balances de múltiples corrientes. En mezcla se conservan ṁda, ṁda·W y ṁda·h; no es válido promediar directamente caudales volumétricos."
                                   TextWrapping="Wrap" Margin="0,4,0,17"/>
                        <TextBlock Text="4. Ejercicios de las diapositivas 22–24 y 32–36" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Auditorio: 300 personas y 8 L/s por persona; para la carga total se necesitan estados y un modelo de flujos/cargas. UTA: 3000 m³/h de retorno y 500 m³/h de aire exterior, convertir cada volumen por su propio volumen específico. FCS interior 0,75 y BF 0,2 no determinan por sí solos un estado único de impulsión sin datos suficientes del serpentín y cargas."
                                   TextWrapping="Wrap" Margin="0,4,0,16"/>
                        <TextBlock Text="5. Climatización, serpentín, ADP, bypass y RSHF/GSHF (diapositivas 25–36)"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
